# LLM Provider Configuration
# Choose between: gemini, openai, or mock (offline)
LLM_PROVIDER=gemini
GOOGLE_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gemini-2.0-flash

# Sandbox Guards & Resource Limits
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MEMORY_LIMIT=256m
SANDBOX_CPU_QUOTA=50000
SANDBOX_DOCKER_IMAGE=python:3.12-slim
FORCE_LOCAL_SANDBOX=false

# PostgreSQL Checkpointing
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agentic_workflow
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis Pub/Sub Event Streaming
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
